if (!function_exists('renderRightSearchBuyTable')) {
	function renderRightSearchBuyTable($keyword, $location_filter) {
		global $con;
		$keyword = trim(str_replace(array('+', '%20'), ' ', (string)$keyword));
		if ($keyword === '') {
			return;
		}
		$parts = preg_split('/\s+/', $keyword);
		$clauses = array();
		foreach ($parts as $part) {
			$part = trim($part);
			if ($part === '') {
				continue;
			}
			$safe = mysqli_real_escape_string($con, $part);
			$clauses[] = "(br_pd_name LIKE '%".$safe."%' OR br_requirement LIKE '%".$safe."%')";
		}
		if (empty($clauses)) {
			return;
		}
		$where_keywords = implode(' OR ', $clauses);
		$sql_count = "SELECT COUNT(*) AS total FROM buy_requirement, user WHERE br_u_id=usr_id AND br_approval_status='1' AND br_status='1' AND br_display_status='1' AND (".$where_keywords.") ".$location_filter;
		$count_result = mysqli_query($con, $sql_count);
		$count_row = $count_result ? mysqli_fetch_assoc($count_result) : array('total' => 0);
		$total = (int)($count_row['total'] ?? 0);
		if ($total < 1) {
			$sql_latest = "SELECT * FROM buy_requirement, user WHERE br_u_id=usr_id AND br_approval_status='1' AND br_status='1' AND br_display_status='1' ".$location_filter." ORDER BY br_id DESC LIMIT 0,5";
			$list_result = mysqli_query($con, $sql_latest);
		} else {
			$sql_list = "SELECT * FROM buy_requirement, user WHERE br_u_id=usr_id AND br_approval_status='1' AND br_status='1' AND br_display_status='1' AND (".$where_keywords.") ".$location_filter." ORDER BY br_id DESC LIMIT 0,5";
			$list_result = mysqli_query($con, $sql_list);
		}
		if (!$list_result || mysqli_num_rows($list_result) < 1) {
			return;
		}
		$shown_total = $total > 0 ? $total : mysqli_num_rows($list_result);
		$padded_total = str_pad((string)$shown_total, 4, '0', STR_PAD_LEFT);
		?>
		<div class="search-buy-table">
			<div class="search-buy-table-head">
				<h3>طلبات شراء مرتبطة</h3>
				<span class="search-buy-table-count"><?php echo htmlspecialchars($padded_total); ?></span>
			</div>
			<?php while ($row_br = mysqli_fetch_object($list_result)) {
				$country_name = get_country_name((int)$row_br->country);
				$flag_name = get_country_flag((int)$row_br->country);
				$flag_html = $flag_name != '' ? '<img src="images/country_flag/'.htmlspecialchars($flag_name).'" alt="'.htmlspecialchars($country_name).'">' : '';
				$detail_url = 'buyleads-details.php?id='.rand(1000, 9999).md5((string)$row_br->br_id);
				$qty = '';
				if (($row_br->br_estimate_qty ?? '') != '' && ($row_br->br_estimate_qty ?? '') != '0') {
					$qty = 'الكمية: '.htmlspecialchars($row_br->br_estimate_qty).' '.htmlspecialchars(measurement_unit((int)$row_br->br_estimate_qty_unit));
				}
				?>
				<div class="search-buy-row">
					<a class="search-buy-title" href="<?php echo $detail_url; ?>" target="_blank"><?php echo htmlspecialchars(ucwords(stripslashes($row_br->br_pd_name))); ?></a>
					<span class="search-buy-badge">مشتري متحقق منه</span>
					<div class="search-buy-meta"><?php echo $flag_html; ?><?php echo htmlspecialchars($country_name); ?><?php if ($qty != '') { ?> · <?php echo $qty; ?><?php } ?></div>
				</div>
			<?php } ?>
			<a class="search-buy-action" href="post-buy-req.php?keywords=<?php echo urlencode($keyword); ?>">أنشر طلب شراء لهذا البحث</a>
		</div>
		<?php
	}
