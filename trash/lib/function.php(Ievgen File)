function Show_shortcontent($text, $count)
{ 
	$text = str_replace("  ", " ", $text); 
	$string = explode(" ", $text); 
	for ( $wordCounter = 0; $wordCounter <= $count;$wordCounter++ )
	{ 
	  $trimed .= $string[$wordCounter]; 
	  if($wordCounter < $count )
	  { 
        $trimed .= ""; 
	   } 
	  else{
      		  $trimed .= "...";
		  } 
	} 
	$trimed = trim($trimed); 
	return $trimed; 
} 
