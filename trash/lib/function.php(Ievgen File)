$newdate = date ( 'Y-m-j' , $newdate );
 
return $newdate;
}

function random_ID($x,$char)       // $x = random Id length | $char = character you want to add before id for identification
{
	$random = '';
  			for ($i = 0; $i < $x; $i++) {
					$random .= rand(0, 1) ? rand(0, 9) : chr(rand(ord('A'), ord('Z')));
  				}
	return $char.$random;
}
