		
		<!DOCTYPE html>
		<html>
		<body>
		<div align="center">
			<!-- Get connection data-->
			<form method="post">
				<table>
					<tr>
						<td>Connection Type: </td>
						<td>
							<select name="config">
								<option value="auto" selected>Auto Select</option>
								<option value="mysqli">MySQLi</option>
								<option value="mysql">MySQL</option>
							</select>
						</td>
					</tr>
					<tr>
						<td>Host Name: </td>
						<td><input type="text" name="host" autofocus></td>
					</tr>
					<tr>
						<td>Database Name: </td>
						<td><input type="text" name="database"></td>
					</tr>
					<tr>
						<td>User: </td>
						<td><input type="text" name="user"></td>
					</tr>
					<tr>
						<td>Password: </td>
						<td><input type="password" name="pwd"></td>
					</tr>
					<tr>
						<td>Port (optional): </td>
						<td><input type="number" name="port" min="1" max="65535" value="3306"></td>
					</tr>
					<tr>
						<td colspan=2><div align="center"><input type="submit" value="Connect"></div></td>
					</tr>
				</table>
			</form>
		</div>
		</body>
		</html>
	