    position: relative;
    max-width: 145px;
    margin-top: 0;
    margin-bottom: 5px;
    display: inline;
    padding: 10px
}

.nbs-flexisel-nav-left,
.nbs-flexisel-nav-right {
    width: 30px;
    height: 155px;
    position: absolute;
    cursor: pointer;
    z-index: 100
}

.view,
ul.tab_img {
    position: relative
}

.middle_right h3,
.welcome_desc h3 {
