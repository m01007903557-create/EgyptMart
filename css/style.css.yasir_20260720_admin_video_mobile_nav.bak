    font-weight: 400 Regular
}

.page-header-col1-row1-col3 {
    width: 14%;
    float: left;
    margin: 4px 0 2px -19px
}

.page-header-col1-row1-col4 {
    float: right;
    margin-right: 0;
    width: 22%;
    margin-top: -11px
}

.page-header-col1-row1-col4-row1 {
    width: auto;
    padding: 0 0 0 1px
}

.page-header-col1-row1-col4-row1 h2 {
    font-size: 21px;
    font-weight: 700;
    color: #da4b20;
    padding: 5px 0 0 2px;
    letter-spacing: 2.3px
}

.page-header-col1-row1-col4-row1 p {
    font-size: 11px;
    width: 100%;
    font-weight: 700;
    text-align: center
}

.page-header-col1-row1-col4-row2 {
    width: 100%
}

.page-header-col1-row1-col4-row2-checkbox {
    width: 100%;
    margin-top: 6px;
    margin-left: 5px;
    font-size: 17px;
    margin-right: 10px
}

.page-header-col1-row1-col4-row2-checkbox .radio {
    display: inline-block;
    margin: 0;
    cursor: pointer
}

.page-header-col1-row1-col4-row2-checkbox .radio:hover .inner {
    -webkit-transform: scale(.5);
    -ms-transform: scale(.5);
    transform: scale(.5);
    opacity: .5
}

.page-header-col1-row1-col4-row2-checkbox .radio input {
    width: 1px;
    height: 1px;
    opacity: 0
}

.page-header-col1-row1-col4-row2-checkbox .radio input:checked+.outer .inner {
    -webkit-transform: scale(1);
    -ms-transform: scale(1);
    transform: scale(1);
    opacity: 1
}

.typing {
    display: inline-block;
    width: 100%;
    white-space: nowrap;
    -webkit-animation: type 2s steps(50, end) alternate;
    animation: type 2s steps(50, end) alternate;
    -webkit-animation-iteration-count: infinite;
    animation-iteration-count: infinite
}

@keyframes type {
    from {
        width: 0
    }
}

@-webkit-keyframes type {
    from {
        width: 0
    }
}

.txtbx {
    width: 322px;
    height: 40px;
    border: 1px solid #d6d6d6;
    padding: 2px 2px 2px 2em;
    border-radius: 0;
    font-size: 16px;
    box-shadow: 0 1px 2px 0 #9c9c9c;
    background-color: #fff;
    outline: 0;
    color: #474747;
    margin: 5px
}

.txtbx:active,
.txtbx:focus,
.txtbx:hover {
    border: 2px solid #d6d6d6
}

.txtbx:focus {
    box-shadow: inset 0 1px 2px 0 #9c9c9c
}

.page-header-col1-row2-col2-form-input,
.page-header-col1-row2-col2-form-select {
    -moz-box-shadow: 0 6px 8px rgba(0, 0, 0, .4);
    -webkit-box-shadow: 0 6px 8px rgba(0, 0, 0, .4);
    -khtml-box-shadow: 0 6px 8px rgba(0, 0, 0, .4)
}

.page-header-col1-row1-col4-row2-checkbox .radio input:focus+.outer .inner {
    -webkit-transform: scale(1);
    -ms-transform: scale(1);
    transform: scale(1);
    opacity: 1;
    background-color: #f05323
}

.page-header-col1-row1-col4-row2-checkbox .radio .outer {
    width: 16px;
    height: 16px;
    display: block;
    float: left;
    margin: 4px 5px 10px 0;
    border: 1.4pt solid #2a2a2a;
    border-radius: 50%;
    background-color: #fff
}

.page-header-col1-row1-col4-row2-checkbox .radio .inner {
    -webkit-transition: all .25s ease-in-out;
    transition: all .25s ease-in-out;
    width: 6px;
    height: 6px;
    -webkit-transform: scale(0);
    -ms-transform: scale(0);
    transform: scale(0);
    display: block;
    margin: 4px;
    border-radius: 50%;
    background-color: #f05323;
    opacity: 0
}

.page-header-col1-row1-col4-row2-link {
    width: 100%;
    padding: 0 0 0 13px;
    text-align: center
}

.page-header-col1-row1-col4-row2-link a {
