.top-bar {
    background-color:#000000;
    line-height: 10px;
    color: #fff;
    box-shadow: 0 5px 2px rgba(102, 102, 102, .5);
    position: relative;
    z-index: 10
}

.top-bar ul {
    margin-bottom: 0
}

.top-bar ul li a {
    color: #fff;
    margin: 0 3px;
    font-weight: 100;
    font-size: 12px;
    padding: 5px 0;
    outline: 0
}

.top-bar ul li a b {
    font-weight: 700;
    padding: 0;
    margin: 0
}

.s-small {
    text-transform: lowercase
}

.top-bar ul li a img {
    margin: 0 0 0 12px
}

.top-bar ul li select {
    background-color: transparent;
    color: #fff;
    border: none;
    outline: 0;
    display: inline-block;
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    cursor: pointer;
    padding-right: 18px;
    margin: 0
}

.testdp ul {
    margin: 0;
    padding: 0;
    background-color: #333
}

li a .dropbtn1 {
    color: #fff;
    text-align: center;
    padding: 14px 16px
}

li:hover.dropdown1 {
    background-color: #fff;
    border-top-width: 0;
    border-bottom-width: 0
}

li:hover.dropdown1>a {
    color: #ffeb00;
    font-weight: 700
}

li.dropdown1>a>b {
    color: #fff450
}

li:hover.dropdown1>a>b {
    color: #fff703
}

.dropdown-content1 {
    display: none;
    position: absolute;
    background-color: #f9f9f9;
    min-width: 151px;
    box-shadow: 0 8px 16px 0 rgba(0, 0, 0, .2);
    margin-left: -1px !important;
    border: 1px solid #000;
    border-top-width: 0
}

.dropdown-content1 a {
    color: #000;
    padding: 12px 16px;
    display: block;
    text-align: left
}

.dropdown-content1 a:hover {
    background-color: #000
}

.dropdown1:hover .dropdown-content1 {
    display: block
}

.space120 {
    margin-left: 120px
}

.more-text {
    font-size: 10px;
