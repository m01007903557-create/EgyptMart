.typography_3_colm {
    display: none;
    position: absolute;
    background: #fff;
    z-index: 100;
    width: 300px;
    border: 1px solid #ddd;
    padding: 10px;
}
.r_1, .r_2, .r_3, .r_4, .r_5, .r_6, .r_7, .r_8, .r_9, .r_10 {
    display: none; /* تبقى مخفية افتراضياً */
}

/* إظهار القسم المناسب عند hover على التصنيف الرئيسي */
.ptag:hover .r_1,
.ptag:hover .r_2,
.ptag:hover .r_3,
.ptag:hover .r_4,
.ptag:hover .r_5,
.ptag:hover .r_6,
.ptag:hover .r_7,
.ptag:hover .r_8,
.ptag:hover .r_9,
.ptag:hover .r_10 {
    display: block !important;
}

#leftsection {
    width: 17% !important;
    float: left !important;
}
#midcenter {
    width: 60% !important;
    float: left !important;
    margin-left: 8px !important;
}
#rightsection {
    width: 22% !important;
    float: right !important;
}





/* 1. قواعد الديسكتوب (لإصلاح hover) */
@media (min-width: 769px) {
    .ptag .typography_3_colm {
        display: none;
    }
    .ptag:hover .typography_3_colm {
        display: block !important;
        position: absolute;
        z-index: 1000;
    }
}

/* 2. قواعد الموبايل (لإصلاح العرض والنقر) */
@media (max-width: 768px) {
    #leftsection, .ptag.navigation, #left_ajax_geting,
    #midcenter, .demobox, .course_demo,
    #rightsection, .bcg-sap_tabs {
        width: 100% !important;
        float: none !important;
        display: block !important;
    }
}

    .typography_3_colm {
        display: none;
    }

    .ptag.open .typography_3_colm {
        display: block;
    }
}

/* إصلاح الصورة الممتدة */
.course_demo img, .slick-product-image img, .mobile-products-grid img {
    max-width: 100%;
    height: auto !important;
    object-fit: contain;
}

/* إخفاء الخريطة على الموبايل */
@media (max-width: 768px) {
    .headertop-custom-box-left {
        display: none !important;
    }
}

@media (max-width: 768px) {
    .headertop-custom-box-left {
        display: none !important;
    }
}

@media (max-width: 768px) {
    .demobox.desktop-only,
    .list-rights.desktop-only,
    .countrubox_top2 .desktop-only {
        display: none !important;
    }
}

/* إخفاء سلايدر عروض البيع الخاصة فقط */
@media (max-width: 768px) {
    .demobox.oyee {
        display: none !important;
    }
}

#rightsection {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
}





@media (max-width: 768px) {
    #rightsection {
        position: static;
        margin-bottom: 0;
        top: 0;
    }
}


/* تحويل السلايدر إلى شبكة عادية على الموبايل */
@media (max-width: 768px) {
    .slick-track {
        display: flex !important;
        flex-wrap: wrap !important;
        justify-content: space-between !important;
    }
    
    #product_slider .slick-slide {
        width: 48% !important;
        margin-bottom: 15px !important;
        float: none !important;
      
    }
}
@media (max-width: 768px) {
    .slick-slide {
        margin-bottom: 20px !important;
    }
}
/* تقليل التباعد الرأسي في سلايدر المنتجات */
.slick-product-image {
    margin-bottom: 5px !important;
    padding-bottom: 0 !important;
}

.slick-slide .matterbox {
    margin-top: 0 !important;
    padding-top: 0 !important;
}

/* إزالة المسافات الزائدة بين العناصر */
.slick-slide > div {
    margin-bottom: 10px !important;
}


