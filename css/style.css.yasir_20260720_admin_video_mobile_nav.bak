\

.dropdown1 {
    position: relative;
}

.dropdown1:hover .dropdown-menu {
    display: block !important;
}



.dropdown-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    background: #fff;
    min-width: 200px;
    box-shadow: 0px 8px 16px rgba(0,0,0,0.2);
    z-index: 1000;
}




.nbs-flexisel-ul,
.testdp ul,
ul.country li {
