        animation: upperStripMove 18s linear infinite;
    }

    #topbar .top-mid > ul > span:hover {
        animation-play-state: paused;
    }
}

@keyframes upperStripMove {
    0% {
        transform: translateX(12px);
    }
    50% {
        transform: translateX(-12px);
    }
    100% {
        transform: translateX(12px);
    }
}

