/* تنسيق الأقسام الرئيسية */
.demobox {
    width: 100%;
    overflow: hidden;
}
#leftsection {
    width: 20%;
    float: left;
}
#midcenter {
    width: 60%;
    float: left;
}
#rightsection {
    width: 20%;
    float: left;
}

/* للشاشات الصغيرة */
@media (max-width: 768px) {
    #leftsection, #midcenter, #rightsection {
        width: 100%;
        float: none;
    }
    #midcenter .slick-slide img {
    width: 100% !important;
    height: auto !important;
}
.slick-track {
    display: flex !important;
}
.slick-slide {
    height: auto !important;
}
}

