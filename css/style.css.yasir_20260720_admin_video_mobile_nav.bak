    cursor: pointer
}

.page-header-col1-row2-col2-form {
    width: 100%;
    padding: 7px 0 0;
    position: relative;
    margin: .4em 0 0
}

.page-header-col1-row2-col2-form-select {
    width: 23%;
    font-size: 16px;
    padding: 18px 10px;
    background: url(../images/page-header-col1-row1-col1-row2-form-select-bg.png) 90% 53% no-repeat;
    border: 2px solid #3b3b48;
    border-radius: 5px;
    height: 65px;
    box-shadow: 0 6px 8px rgba(0, 0, 0, .4)
}

.page-header-col1-row2-col2-form-select1 {
    width: 100%;
    font-size: 12px;
    padding: 6px;
    background: url(../images/page-header-col1-row1-col1-row2-form-select-bg.png) 88% 53% no-repeat;
    border: 1px solid #3b3b48;
    border-radius: 2px;
    box-shadow: 0 0 0 #595959;
    height: 36px
}

.page-header-col1-row2-col2-form-input {
    border: 1px solid #00f;
    border-radius: 5px;
    box-shadow: 0 1px 6px 1px rgba(0, 0, 0, .5);
    float: left;
    height: 45px;
    padding: 18px 55px 18px 10px;
    text-align: center;
    width: 90%
}

.page-header-col1-row2-col2-form-btn {
