}

@media only screen and (-webkit-min-device-pixel-ratio:1.2),
only screen and (-o-min-device-pixel-ratio:32),
only screen and (min--moz-device-pixel-ratio:1.5),
only screen and (min-device-pixel-ratio:1.5) {

    body,
    html {
        width: 100%;
