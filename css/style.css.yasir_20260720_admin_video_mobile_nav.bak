.auth-popup-overlay {
    align-items: center;
    background: #043948;
    bottom: 0;
    display: none;
    justify-content: center;
    left: 0;
    padding: 18px;
    position: fixed;
    right: 0;
    top: 0;
    z-index: 99999;
}

.auth-popup-overlay:before,
.auth-popup-overlay:after {
    background: rgba(16, 91, 110, .46);
    content: "";
    height: 330px;
    position: absolute;
    transform: rotate(45deg);
    width: 330px;
}

.auth-popup-overlay:before {
    left: -130px;
    top: 130px;
}

.auth-popup-overlay:after {
    border-radius: 50%;
    bottom: -90px;
    right: -90px;
}

.auth-popup-overlay.is-open {
    display: flex;
}

.auth-popup-card {
    background: #fff;
    border-radius: 6px;
    box-shadow: 0 24px 70px rgba(0, 0, 0, .35);
    direction: ltr;
    max-height: calc(100vh - 36px);
    max-width: 510px;
    overflow: auto;
    padding: 26px 24px 22px;
    position: relative;
    text-align: left;
    width: 100%;
    z-index: 1;
}

.auth-popup-close {
    background: transparent;
    border: 0;
    color: #455a64;
    cursor: pointer;
    font-size: 28px;
    height: 32px;
    line-height: 28px;
    position: absolute;
    right: 14px;
    top: 8px;
    width: 32px;
}

.auth-popup-tabs {
    display: grid;
    gap: 8px;
    grid-template-columns: 1fr 1fr;
    margin-bottom: 18px;
}

.auth-popup-tab {
    background: transparent;
    border: 0;
    color: #0a4353;
    cursor: pointer;
    font-family: inherit;
    font-size: 15px;
    font-weight: 700;
    min-height: 42px;
}

.auth-popup-tab.active {
    border-bottom: 3px solid #00566b;
}

.auth-popup-panel {
    display: none;
}

.auth-popup-panel.active {
    display: block;
}

.auth-popup-panel h3 {
    color: #0f172a;
    font-size: 22px;
    font-weight: 800;
    margin: 0 0 20px;
    text-align: center;
}

.auth-popup-panel p {
    color: #475569;
    font-size: 15px;
    line-height: 1.7;
    margin: 0 0 18px;
}

.auth-popup-form input[type="text"],
.auth-popup-form input[type="password"] {
    border: 1px solid #cbd5e1;
    box-sizing: border-box;
    color: #0f172a;
    display: block;
    font-size: 15px;
    height: 46px;
    margin-bottom: 12px;
    padding: 0 14px;
    text-align: left;
    width: 100%;
}

.auth-popup-optin {
    align-items: flex-start;
    color: #334155;
    display: flex;
    font-size: 14px;
    gap: 8px;
    line-height: 1.6;
    margin: 10px 0 16px;
}

.auth-popup-optin input {
    flex: 0 0 auto;
    margin-top: 5px;
}

.auth-popup-form button,
.auth-popup-primary,
.auth-popup-secondary {
    border-radius: 7px;
    box-sizing: border-box;
    display: block;
    font-family: inherit;
    font-size: 16px;
    font-weight: 800;
    min-height: 46px;
    padding: 12px 16px;
    text-align: center;
    text-decoration: none;
    width: 100%;
}

.auth-popup-form button,
.auth-popup-primary {
    background: #00566b;
    border: 1px solid #00566b;
    color: #fff;
}

.auth-popup-secondary {
    background: #fff;
    border: 1px solid #cbd5e1;
    color: #0f172a;
    margin-top: 10px;
}

.auth-popup-link {
    color: #0f766e;
    display: inline-block;
    font-weight: 700;
    margin-top: 14px;
}

.auth-popup-google {
    border: 1px solid #d5dadd;
    color: #333;
    display: block;
    font-size: 15px;
    font-weight: 700;
    padding: 12px;
    text-align: center;
    text-decoration: none;
}

.auth-popup-divider {
    border-top: 1px solid #e0e0e0;
    margin: 26px 0 20px;
    text-align: center;
}

.auth-popup-divider span {
    background: #fff;
    color: #777;
    padding: 0 20px;
    position: relative;
    top: -11px;
}

.auth-popup-choice {
    display: flex;
    gap: 28px;
    margin-bottom: 18px;
}

.auth-popup-terms,
.auth-popup-help {
    color: #667;
    display: block;
    font-size: 12px;
    margin: 10px 0;
    text-align: center;
}

.auth-popup-switch {
    background: transparent;
    border: 0;
    color: #0a4353;
    cursor: pointer;
    display: block;
    font-weight: 800;
    margin: 12px auto 0;
}

.auth-popup-help {
    color: #fff;
    margin: 42px 0 -2px;
}

.quick-nav-link {
    display: inline-block;
    font-weight: 700;
    padding: 0 6px;
    white-space: nowrap;
}

