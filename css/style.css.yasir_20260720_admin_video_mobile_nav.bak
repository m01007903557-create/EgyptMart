.nbs-flexisel-container {
    position: relative;
    max-width: 100%
}

.nbs-flexisel-ul {
    position: relative;
    width: 9999px;
    margin: 0;
    padding: 0;
    text-align: center
}

.nbs-flexisel-inner {
    margin: 3px 4% 10px 6%;
    width: 88%;
    height: auto
}

.nbs-flexisel-item {
    float: left;
    margin: 0;
    padding: 0;
    cursor: pointer;
    position: relative;
    line-height: 0;
    width: auto
}

.black {
    border: 1px solid #666362;
    border-radius: 3px;
    box-shadow: 0 0 1px #979495
}

.blue {
    border: 1px solid #2e68b2;
    border-radius: 3px;
    box-shadow: 0 0 1px #2e68b2
}

.nbs-flexisel-item img {
    width: 100%;
