}

@media screen and (-webkit-min-device-pixel-ratio:0) {
    .top-bar ul li select {
        padding-right: 18px;
        -moz-padding-right: 18px
    }
}

.top-bar ul li label {
    position: relative
}

.top-bar ul li label:after {
    content: '>';
    font-size: 11px;
    color: #fff;
    -webkit-transform: rotate(90deg);
    -moz-transform: rotate(90deg);
    -ms-transform: rotate(90deg);
    transform: rotate(90deg);
    right: 8px;
    top: 7px;
    padding: 0 0 2px;
    position: absolute;
    pointer-events: none
}

.top-bar ul li label:before {
    content: '';
    right: 6px;
    top: 0;
    width: 20px;
    height: 20px;
    position: absolute;
    pointer-events: none
}

