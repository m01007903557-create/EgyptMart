    }
}

.clear {
    clear: both
}

.fleft {
    float: left
}

img {
    outline: 0;
    border: none
}

div {
    -moz-box-sizing: border-box;
    -webkit-box-sizing: border-box;
    box-sizing: border-box
}

a {
    outline: 0
}

a:hover {
    transition: .5s all;
    -webkit-transition: .5s all;
    -moz-transition: .5s all;
    -o-transition: .5s all
}

input[type=button],
input[type=submit],
li.parallelogram {
    transition: .5s all;
    -webkit-transition: .5s all;
    -moz-transition: .5s all;
    -o-transition: .5s all;
    -ms-transition: .5s all
}

